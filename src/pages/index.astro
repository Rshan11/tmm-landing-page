---
import Layout from '../components/Layout.astro';
import MasonXMonogram from '../components/MasonXMonogram.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Hero from '../components/Hero.astro';
import EstimateExample from '../components/EstimateExample.astro';
import ProofStrip from '../components/ProofStrip.astro';
import SectionDivider from '../components/SectionDivider.astro';
import SeeItSection from '../components/SeeItSection.astro';
import SeeItWorkSection from '../components/SeeItWorkSection.astro';
import LeadSection from '../components/LeadSection.astro';
import ComingStrip from '../components/ComingStrip.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import rakeClipPoster from '../assets/media/raise-wall-rake-poster.png';
import stoneClipPoster from '../assets/media/stone-radius-rake-poster.png';
import leadClipPoster from '../assets/media/lead-georgeville-poster.png';
import arClipPoster from '../assets/media/lead-ar-layout-walk-poster.png';
import PillarsSection from '../components/PillarsSection.astro';
import SheetMoment from '../components/SheetMoment.astro';
import DifferenceTable from '../components/DifferenceTable.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTA from '../components/FinalCTA.astro';

const title = 'Masonry Estimating Software & Shop Drawings | The Masonry Modeler';
const description = 'Masonry estimating software built by a mason. Edit walls in 3-D and the bond, counts and bid follow. Shop drawings, and The Lead for the crew.';
const canonical = 'https://themasonrymodeler.com/';

const faqItems = [
  {
    question: 'Does TMM count corners and halves while I draw?',
    answer: 'Yes. TMM counts fulls, halves, and corners from the first click as you draw your walls. The pieces are counted by type and carried into the takeoff and estimate. Review the specified units, finishes, and prices for the wall you intend to build.',
  },
  {
    question: 'What does masonry estimating software calculate?',
    answer: 'TMM connects wall quantities to material prices, production rates, crew labor, equipment, overhead, and profit. Review the included scope and your rates before issuing a bid. The same wall model also produces shop drawings.',
  },
  {
    question: 'Can I use my own supplier prices and crews?',
    answer: 'Yes. Set your material prices, production rates, crew, and equipment, then review the estimate by item. Your job conditions and costs determine the bid.',
  },
  {
    question: 'How do corners work in The Masonry Modeler?',
    answer: 'Corners interlock by default — inside and outside. The bond runs through the corner. No butt joints unless overridden. The corner is a consequence of the bond, not a special case bolted on top.',
  },
  {
    question: 'How does The Masonry Modeler handle non-modular leftover at corners?',
    answer: 'Non-modular leftover absorbs into the corner. The leg moves 8 inches every course — same as the bond. No 4-inch cut exposed in the field.',
  },
  {
    question: 'What is the default control joint spacing?',
    answer: 'Control joints default to 24 feet 8 inches — 296 inches, which is 18.5 blocks times 16 inches exactly. This is the modular spacing. Drag to override. Control joints are never auto-placed within 16 inches of a corner.',
  },
  {
    question: 'How are bond beams placed?',
    answer: 'Rebar drives bond beams. Set the rebar schedule from the structural drawings and courses snap to match. Development-length extension past openings is automatic. Weight is reported in pounds, not just linear feet.',
  },
  {
    question: 'Does The Masonry Modeler handle half-high courses?',
    answer: 'Yes. Review the partial-height course in the elevation and takeoff. It may use a specified half-high unit or a cut from full-height stock; the purchased block and the remaining piece height have different roles in the estimate.',
  },
  {
    question: 'Will The Masonry Modeler produce cuts smaller than 4 inches?',
    answer: 'TMM resolves coursing and shows the resulting pieces. Tight openings, corners, and special details can need small closures. Review the elevation and cutting list for the detail you intend to build.',
  },
  {
    question: 'How are 10-inch and 12-inch CMU corners handled?',
    answer: '10-inch and 12-inch CMU corners use an 8-inch block plus a face shell spacer — listed as separate takeoff line items, the way the supplier ships them and the way the crew lays them.',
  },
  {
    question: 'Can the mason override it?',
    answer: 'Yes. Select a block and change its type to match the detail you intend to build. Review the updated takeoff and estimate before issuing the bid.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer },
  })),
};

// Lead embed — the short trace clip. uploadDate is the exact publish instant
// from the channel's RSS feed, not a guessed date. `duration` is intentionally
// omitted rather than invented; add it (ISO 8601, e.g. "PT38S") once known.
const shortVideoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Tracing a CMU wall on the print in The Masonry Modeler",
  "description": "Short clip: setting the wall type and tracing a segment on an architect's print in The Masonry Modeler, with dimensions landing live as the wall is drawn — 8-inch CMU, 18 feet 8 inches long, 11 feet 4 inches tall.",
  "thumbnailUrl": ["https://i.ytimg.com/vi/eBQulJ2CVEE/maxresdefault.jpg"],
  "uploadDate": "2026-07-27T02:58:38+00:00",
  "embedUrl": "https://www.youtube.com/embed/eBQulJ2CVEE",
  "contentUrl": "https://youtu.be/eBQulJ2CVEE",
  "publisher": {
    "@type": "Organization",
    "name": "The Masonry Modeler",
    "url": "https://themasonrymodeler.com/",
  },
};

const rakeVideoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "A CMU pump station modeled in two minutes in The Masonry Modeler",
  "description": "A sped-up, silent product recording: drag one box to draw all four CMU walls at once, add four openings and move them in the 3D model, then add rakes, control joints, and two block colors. Two minutes of real work, start to finish.",
  "thumbnailUrl": ["https://themasonrymodeler.com/assets/video/pump-station-demo-poster.jpg"],
  "contentUrl": "https://themasonrymodeler.com/assets/video/pump-station-demo.mp4",
  "uploadDate": "2026-10-08",
  "duration": "PT15.766S",
};

// Short silent clips in "See it work" and "The Lead" (added 2026-10-30).
const site = 'https://themasonrymodeler.com';
const clip = async (name: string, title: string, desc: string, poster: ImageMetadata, duration: string) => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": desc,
  "thumbnailUrl": [site + (await getImage({ src: poster, format: 'webp', width: Math.min(960, poster.width), quality: 72 })).src],
  "contentUrl": `${site}/assets/video/${name}.mp4`,
  "uploadDate": "2026-10-30",
  "duration": duration,
});
const clipSchemas = await Promise.all([
  clip('raise-wall-rake', 'Raising walls and sloping a rake in The Masonry Modeler',
    'Silent clip: CMU walls raised in 3-D and a rake sloped into the next wall; the bond and counts update during the drag.', rakeClipPoster, 'PT6S'),
  clip('stone-radius-rake', 'A stone radius wall with a rake in The Masonry Modeler',
    'Silent clip: a round stone wall edited in 3-D over the floor plan, with a rake sloped between neighboring walls.', stoneClipPoster, 'PT15S'),
  clip('lead-georgeville', 'The Lead: Georgeville Arsenic Pump Station',
    'Silent clip of The Lead, the crew view of the model: whole job, sides A to D and lifts, colored by type, rebar, production or schedule, with block counts by size and color, grout and mortar.', leadClipPoster, 'PT9S'),
  clip('lead-ar-layout-walk', 'The Lead AR layout walk',
    'Silent phone recording of the AR layout walk in The Lead: aim at the corner on the footing, set the corners, and read the measured distance against the plan dimension.', arClipPoster, 'PT12S'),
]);

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Building a Pump Station in The Masonry Modeler",
  "description": "Three-minute screen recording of a pump station traced and taken off in The Masonry Modeler. Walls, corners, lintels, bond beams, and the block-by-block takeoff — start to finish.",
  "thumbnailUrl": ["https://i.ytimg.com/vi/m-fSK2uB924/maxresdefault.jpg"],
  "uploadDate": "2026-05-25",
  "duration": "PT3M",
  "embedUrl": "https://www.youtube.com/embed/m-fSK2uB924",
  "contentUrl": "https://youtu.be/m-fSK2uB924",
  "publisher": {
    "@type": "Organization",
    "name": "The Masonry Modeler",
    "url": "https://themasonrymodeler.com/",
  },
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/video/pump-station-demo-poster.jpg" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(rakeVideoSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(shortVideoSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
    {clipSchemas.map((c) => <script type="application/ld+json" set:html={JSON.stringify(c)} />)}
  </Fragment>

  <MasonXMonogram />
  <TitleBlock />

  <Hero />
  <ProofStrip />

  <SectionDivider number="02" label="See It Work" />
  <SeeItWorkSection sectionNum="02" />

  <SectionDivider number="03" label="The Lead" />
  <LeadSection sectionNum="03" />
  <ComingStrip />

  <SectionDivider number="04" label="From Takeoff to Bid" />
  <EstimateExample compact sectionNum="04" />

  <SectionDivider number="05" label="On The Print" />
  <SeeItSection sectionNum="05" />

  <SectionDivider number="06" label="Why The Number Is Right" />
  <PillarsSection sectionNum="06" />

  <SectionDivider number="07" label="The Shop Drawing" />
  <SheetMoment sectionNum="07" />

  <SectionDivider number="08" label="The Difference" />
  <!-- PM4Subs cross-sell strip removed 2026-07-27: TMM is positioned as a
       standalone specialized product, so the homepage doesn't pitch a second
       one ahead of pricing. SuiteStrip.astro and its CSS are retained — drop
       <SuiteStrip /> back here to restore. Footer link to PM4Subs stays. -->
  <DifferenceTable sectionNum="08" />

  <SectionDivider number="09" label="Founder Pricing" />
  <PricingSection sectionNum="09" />

  <SectionDivider number="10" label="Common Questions" />
  <FAQSection
    items={faqItems}
    sectionNum="10"
    headline="What the job site asks about masonry estimating."
  />

  <FinalCTA />
</Layout>
