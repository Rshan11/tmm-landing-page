---
// Homepage — one pain (the estimator on an island), one live demo, four tiles
// to the one-pain pages, one line about what's next. Everything that used to
// live here (worked estimate, screenshots, pillars, shop drawing, comparison,
// pricing, FAQ) moved to /how-it-works/ unchanged.
import Layout from '../components/Layout.astro';
import MasonXMonogram from '../components/MasonXMonogram.astro';
import TitleBlock from '../components/TitleBlock.astro';
import TryItSection from '../components/TryItSection.astro';
import PageTiles from '../components/PageTiles.astro';
import SendPrints from '../components/SendPrints.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Masonry Estimating Software Built by a Mason | The Masonry Modeler';
const description = 'Masonry estimating software that counts every wall, piece and special shape by wall and lift before you sign. Then your crew builds from the same count.';
const canonical = 'https://themasonrymodeler.com/';
---

<Layout title={title} description={description} canonical={canonical}>
  <MasonXMonogram />
  <TitleBlock />

  <section class="pain-hero">
    <div class="pain-inner">
      <p class="pain-kicker">Masonry estimating software · built by a mason contractor</p>
      <ul class="pain-questions">
        <li>Leaving money on the table?</li>
        <li>Missed a wall?</li>
        <li>Short the pieces with the crew standing there?</li>
        <li>Ever blown a special order?</li>
      </ul>
      <div class="pain-split">
        <h1 class="pain-h1">You're on <span class="accent">an island.</span></h1>
        <p class="pain-body">Nobody else can figure out the count. Everybody has something to say when it's off. <span class="hi">But none of them could do it better.</span> The special order is six weeks out and the GC wants the wall up Monday. <span class="hi">We know — we're a mason contractor. So we built the thing we needed.</span></p>
      </div>
      <div class="pain-band">
        <p><strong>Every wall. Every piece. Every special shape — counted by wall and lift before you sign.</strong> Then your crew builds from the same count.</p>
        <div class="pain-actions">
          <a class="pain-btn" href="#send">Send us your next bid</a>
          <a class="pain-btn-alt" href="#try-it">Try a real job</a>
        </div>
      </div>
      <p class="pain-mono">Built at Powder River Masonry · we bid our own work with it every week</p>
    </div>
  </section>

  <TryItSection />

  <PageTiles showNext />

  <SendPrints id="demo" source="home" />

  <SiteFooter />
</Layout>
