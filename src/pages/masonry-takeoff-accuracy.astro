---
import Layout from '../components/Layout.astro';
import MasonXMonogram from '../components/MasonXMonogram.astro';
import TitleBlock from '../components/TitleBlock.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import FAQSection from '../components/FAQSection.astro';

const title = 'Why Masonry Takeoffs Are Wrong (And the Fix) | The Masonry Modeler';
const description = 'Masonry takeoff errors come from three places: lintels, corners, and half-block courses. TMM renders each as you draw and counts what is actually there.';
const canonical = 'https://themasonrymodeler.com/masonry-takeoff-accuracy/';

const faqItems = [
  {
    question: 'What causes most masonry takeoff errors?',
    answer: 'Three things cause almost every repeating error: lintels (courses above and below don\'t land right), corners (corner blocks counted as stretchers), and non-modular heights (half-high courses missed or buried in waste). TMM handles all three by rendering the wall before counting it.',
  },
  {
    question: 'How does TMM handle the lintel course problem?',
    answer: 'It calculates how courses land above and below every opening, including bond beam continuity across the header. The bearing course and the bond step are rendered — not approximated. The lintel unit count comes from the actual opening width, not from a rule of thumb.',
  },
  {
    question: 'What is the half-block zipper and why does it matter?',
    answer: 'When a wall length doesn\'t divide evenly by 16 inches, every other course needs a cut block at one end to maintain running bond. This alternating pattern is the "zipper." Square-footage methods miss it entirely. TMM renders both course patterns and counts the cuts as separate line items.',
  },
  {
    question: 'Can TMM eliminate the waste factor entirely?',
    answer: 'The waste factor covers breakage and field cutting, not estimation error. TMM eliminates the estimation error component — wrong unit counts, missed unit types, misidentified corners. A small breakage allowance still makes sense. But padding for a bad count is different from breakage, and TMM removes the need for the former.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer },
  })),
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Fix the Three Most Common Masonry Takeoff Errors",
  "description": "Three problems cause almost every masonry takeoff error: lintels that don't land right, corners counted as stretchers, and half-block courses missed. Render each one before counting.",
  "totalTime": "PT20M",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Render the lintel course before counting it",
      "text": "Calculate how courses land above and below every opening, including bond beam continuity across the header. The lintel unit count comes from the actual opening width, not a rule of thumb." },
    { "@type": "HowToStep", "position": 2, "name": "Count corners as their own unit, not as stretchers",
      "text": "Mark wall intersections as corners so corner blocks (including 10-inch and 12-inch corner-plus-face-shell assemblies) become separate line items on the takeoff." },
    { "@type": "HowToStep", "position": 3, "name": "Catch non-modular heights and half-high courses",
      "text": "When the wall height does not divide evenly by 8 inches, generate the half-high course at top or bottom as its own line item — counted, weighted, and priced separately." },
    { "@type": "HowToStep", "position": 4, "name": "Replace estimation padding with a true breakage allowance",
      "text": "Remove the waste factor that was covering missed unit types. Keep a small allowance for field breakage only, separated from the rendered unit counts." },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://themasonrymodeler.com/" },
    { "@type": "ListItem", "position": 2, "name": "Masonry Takeoff Accuracy", "item": canonical },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Masonry Takeoff in The Masonry Modeler — Pump Station, Three Problems Solved",
  "description": "Three-minute pump station trace in TMM showing the three repeating takeoff errors — lintels, corners, and half-block courses — handled correctly as the wall is rendered.",
  "thumbnailUrl": ["https://i.ytimg.com/vi/m-fSK2uB924/maxresdefault.jpg"],
  "uploadDate": "2026-05-25",
  "duration": "PT3M",
  "embedUrl": "https://www.youtube.com/embed/m-fSK2uB924",
  "contentUrl": "https://youtu.be/m-fSK2uB924",
  "publisher": {
    "@type": "Organization",
    "name": "The Masonry Modeler",
    "url": "https://themasonrymodeler.com/",
  },
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  </Fragment>

  <MasonXMonogram />
  <TitleBlock sheet="A2.3 — Masonry Takeoff Accuracy" />

  <PageHero
    kicker="Masonry Takeoff Accuracy · Three Problems"
    headline="Why Masonry Takeoffs Are Wrong (And How to Fix It)"
    lead="The same three problems cause almost every masonry takeoff error: lintels that don't land right, corners counted as stretchers, and half-block courses that appear on the job but not in the estimate. TMM is masonry estimating software that renders all three as you draw."
  />

  <section class="page-section">
    <div class="page-section-inner">
      <h2>Problem 1: The Lintel</h2>
      <p>
        Every opening punches a hole in the running bond. The courses above and below have to land somewhere — and where they land depends on the opening width, the wall height above, and where the bond beam sits. Get any of those wrong and the count is wrong.
      </p>
      <p>
        Most tools skip this calculation and let the estimator figure it out manually. TMM renders the bond across the opening. The bearing course is there. The lintel unit count comes from the actual opening width. The bond beam continuity is automatic.
      </p>

      <div class="code-diagram">
        <div class="code-diagram-label">Lintel zone · opening 5'-4" wide</div>
        <pre>
<span class="dim">Course 9</span>   S    S    S    S    S    S    S    S    S
<span class="highlight">Course 8</span>   BB   BB  <span class="highlight"> LT   LT   LT   LT </span>  BB   BB   BB   ← <span class="highlight">lintel + bond beam</span>
<span class="dim">Course 7</span>   S    S  <span class="dim"> ░░░░░░░░░░░░░░ </span>  S    S    S
<span class="dim">Course 6</span>   S    S  <span class="dim"> ░  OPENING  ░ </span>  S    S    S
<span class="dim">Course 5</span>   S    S  <span class="dim"> ░░░░░░░░░░░░░░ </span>  S    S    S

<span class="dim">           LT = lintel unit   BB = bond beam   S = stretcher</span>
<span class="bright">           4 lintel units · counted from opening width, not estimated</span></pre>
      </div>
    </div>
  </section>

  <section class="page-section page-section-dark">
    <div class="page-section-inner">
      <h2>Problem 2: The Corner</h2>
      <p>
        Corner blocks aren't stretchers. Outside corners need a unit with a finished face on two sides. Inside corners need a different geometry altogether. Both are different part numbers, different pricing, different lead times at some suppliers.
      </p>
      <p>
        A square-footage takeoff applies 1.125 blocks per square foot and rounds up. The corner is in there somewhere — counted as a stretcher, priced as a stretcher, ordered as a stretcher. Then the crew runs out of corner blocks on day two.
      </p>
      <p>
        TMM places corners by position. Every inside corner and every outside corner on every wall segment is identified when the wall is drawn. The count separates automatically. There's no post-processing step, no manual corner tally.
      </p>

      <div class="code-diagram">
        <div class="code-diagram-label">Corner zone · outside corner · running bond</div>
        <pre>
<span class="dim">Wall A →</span>                          <span class="dim">↑ Wall B</span>
Course 4  S    S    S    S   <span class="highlight"> OC </span>   S    S    S
Course 3  S    S    S    S   <span class="highlight"> OC </span>   S    S    S
Course 2  S    S    S    S   <span class="highlight"> OC </span>   S    S    S
Course 1  S    S    S    S   <span class="highlight"> OC </span>   S    S    S

<span class="dim">          S = stretcher    </span><span class="highlight">OC = outside corner (separate line item, every course)</span></pre>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="page-section-inner">
      <h2>Problem 3: The Half-Block Zipper</h2>
      <p>
        Running bond means every other course offsets by 8 inches. When the wall length doesn't divide evenly by 16 inches, that offset doesn't resolve cleanly. One course ends with a full block at the wall end. The course above ends with a cut.
      </p>
      <p>
        That pattern — full, cut, full, cut, alternating — is what masons call the zipper. It runs the full height of the wall at every non-modular end. Every cut block is a separate unit: a field cut (waste), or an ordered half-block (separate part number, cheaper than cutting).
      </p>
      <p>
        A square-footage method absorbs this into the waste factor. TMM renders both course patterns and counts the cut positions explicitly. The mason can decide whether to order half-blocks or plan for field cutting — but either way, the count is right.
      </p>

      <div class="code-diagram">
        <div class="code-diagram-label">Non-modular wall end · 280 lf total · zipper at each segment end</div>
        <pre>
Wall end                                          <span class="highlight">← 2" leftover</span>
Course 13  S    S    S    S    S    S    S   <span class="bright"> S  </span>  ← full block ends this course
Course 12  S    S    S    S    S    S    S   <span class="highlight"> ½  </span>  ← half-block / cut ends this course
Course 11  S    S    S    S    S    S    S   <span class="bright"> S  </span>  ← full block
Course 10  S    S    S    S    S    S    S   <span class="highlight"> ½  </span>  ← half-block / cut
Course  9  S    S    S    S    S    S    S   <span class="bright"> S  </span>  ← full block

<span class="dim">           The zipper repeats every course pair for the full wall height.</span>
<span class="highlight">           TMM counts both patterns. Half-blocks are their own line item.</span></pre>
      </div>
    </div>
  </section>

  <section class="page-section page-section-dark">
    <div class="page-section-inner">
      <h2>All Three, On Camera</h2>
      <p>
        Three minutes. Blank canvas to a counted pump station. Watch the lintel land in the right course, the corner blocks count separately from the stretchers, and the half-high parapet break out as its own line item. The three problems above — solved as the wall draws.
      </p>

      <div class="video-frame on-dark">
        <iframe
          src="https://www.youtube-nocookie.com/embed/m-fSK2uB924"
          title="Building a pump station in The Masonry Modeler — three takeoff problems solved as the wall is traced"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
        <div class="video-frame-caption">
          <span>Pump Station · trace → takeoff · 3 min</span>
          <span><strong>Powder River Masonry</strong> · MasonX</span>
        </div>
      </div>

      <p>
        The same rendered wall produces the submittal — see how these counts become
        <a href="/masonry-shop-drawings">masonry shop drawings</a> automatically, labeled course by course.
      </p>
    </div>
  </section>

  <FAQSection
    items={faqItems}
    sectionNum="FAQ"
    label="Takeoff accuracy questions"
    headline="What the foreman always asks."
  />

  <PageCTA
    headline="Get the count right before the order goes in."
    body="Render the wall, count every unit type, generate the takeoff. Founder pricing at $300/mo while seats last."
  />
</Layout>
