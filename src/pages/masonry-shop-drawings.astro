<script>
  const forms = document.querySelectorAll<HTMLFormElement>('.sample-form');

  forms.forEach((form) => {
    const wrap = form.closest('.sample-download');
    const success = wrap?.querySelector('.sample-form-success') as HTMLElement | null;
    const link = success?.querySelector('.sample-download-link') as HTMLAnchorElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button') as HTMLButtonElement;
      const originalText = btn.innerHTML;
      btn.textContent = 'Sending…';
      btn.disabled = true;

      const reveal = () => {
        form.style.display = 'none';
        if (success) success.hidden = false;
        // Kick off the download so the sheet arrives immediately.
        if (link) link.click();
      };

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          reveal();
        } else {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      } catch {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });
  });
</script>
