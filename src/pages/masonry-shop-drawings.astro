---
import { Image, getImage } from 'astro:assets';
import Layout from '../components/Layout.astro';
import MasonXMonogram from '../components/MasonXMonogram.astro';
import TitleBlock from '../components/TitleBlock.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import FAQSection from '../components/FAQSection.astro';

import sheet01 from '../assets/sheets/sheet-01-plan.png';
import sheet02 from '../assets/sheets/sheet-02-elevation-a.png';
import sheet03 from '../assets/sheets/sheet-03-elevation-b.png';
import sheet04 from '../assets/sheets/sheet-04-elevation-c.png';
import sheet05 from '../assets/sheets/sheet-05-elevation-d.png';
import sheet06 from '../assets/sheets/sheet-06-elevation-e.png';
import sheet07 from '../assets/sheets/sheet-07-elevation-f.png';
import sheet08 from '../assets/sheets/sheet-08-rebar-dowel-layout.png';
import sheet09 from '../assets/sheets/sheet-09-steel-bar-list.png';

const title = 'Masonry Shop Drawings, Drawn As You Build | The Masonry Modeler';
const description = 'Masonry shop drawings, drawn as you build. TMM renders coursed, tagged elevations — openings, bond beams, finishes — plus the steel bar list.';
const canonical = 'https://themasonrymodeler.com/masonry-shop-drawings/';

const samplePdf = '/assets/themasonrymodeler-shop-drawings-sample-15th-pod.pdf';

// The 15th pod set — nine sheets, one trace.
const sheets = [
  {
    num: 'A01', short: 'Plan', img: sheet01,
    alt: 'Masonry shop drawing sheet A01 — foundation plan of the 15th pod, walls dimensioned face-of-wall with elevation call-outs A through F keyed around the perimeter.',
  },
  {
    num: 'A02', short: 'Elevation A', img: sheet02,
    alt: 'Masonry shop drawing sheet A02 — Elevation A, an 11\'-1" wall with a legend color-coding every unit as corner, half, cut, or bond beam, courses numbered C1–C15 with grout lift lines and vertical reinforcing shown in position.',
  },
  {
    num: 'A03', short: 'Elevation B', img: sheet03,
    alt: 'Masonry shop drawing sheet A03 — Elevation B, a 22\'-3" wall in running bond with corner and cut units tagged, two bond beam courses, and vertical bars called out #5 @ 48" on center.',
  },
  {
    num: 'A04', short: 'Elevation C', img: sheet04,
    alt: 'Masonry shop drawing sheet A04 — Elevation C, a 30\'-8" wall showing the split face to ground face finish transition, onyx below and glacier white above, with bond beam courses and vertical reinforcing.',
  },
  {
    num: 'A05', short: 'Elevation D', img: sheet05,
    alt: 'Masonry shop drawing sheet A05 — Elevation D, a 28\'-0" gable end wall with rake coursing stepping up both slopes, a door opening with a (2) #5 lintel, split face to ground face finish transition, corner units, bond beam courses, vertical reinforcing, and a control joint carried through the peak, courses numbered C1–C21 over three grout lifts.',
  },
  {
    num: 'A06', short: 'Elevation E', img: sheet06,
    alt: 'Masonry shop drawing sheet A06 — Elevation E, a 30\'-8" wall with a door opening and lintel, split face to ground face finish transition, bond beam courses, and vertical reinforcing in position.',
  },
  {
    num: 'A07', short: 'Elevation F', img: sheet07,
    alt: 'Masonry shop drawing sheet A07 — Elevation F, a 28\'-0" gable end wall with rake coursing, an offset door opening with a (2) #5 lintel, split face to ground face finishes, bond beam courses, and vertical reinforcing.',
  },
  {
    num: 'A08', short: 'Rebar / Dowel Layout', img: sheet08,
    alt: 'Masonry shop drawing sheet A08 — rebar and dowel layout plan, vertical reinforcing at #5 @ 48" on center with dowels and bond beam steel located around the building perimeter.',
  },
  {
    num: 'A09', short: 'Steel Bar List', img: sheet09,
    alt: 'Masonry shop drawing sheet A09 — steel bar list, 285 bars totaling 2,031.4 linear feet broken out by mark with size, shape code, cut length, and quantity.',
  },
];

// Full-size webp for the "open full sheet" link on each thumbnail (same pipeline as the on-page images).
const fullSheets = await Promise.all(
  sheets.map((s) => getImage({ src: s.img, width: 1600, format: 'webp' }))
);
const heroSheet = sheets[4]; // Elevation D
const legendSheet = sheets[1]; // Elevation A
const barListSheet = sheets[8]; // A09
const rebarSheet = sheets[7]; // A08

// Steel bar list — 15th pod, Sheet A09. Transcribed from the real sheet;
// quantities sum to exactly 285 bars (matches the sheet's stated total).
// DO NOT alter any value.
const barGroups = [
  {
    mark: 'BB', size: '#4', shape: 'straight',
    note: 'Bond beam',
    bars: [
      { length: `0'-7"`, qty: 1 },
      { length: `1'-10"`, qty: 2 },
      { length: `2'-7"`, qty: 2 },
      { length: `3'-7"`, qty: 4 },
      { length: `4'-3"`, qty: 1 },
      { length: `4'-4"`, qty: 2 },
      { length: `6'-4"`, qty: 2 },
      { length: `6'-11"`, qty: 1 },
      { length: `7'-8"`, qty: 2 },
      { length: `9'-4"`, qty: 2 },
      { length: `10'-5"`, qty: 4 },
      { length: `11'-2"`, qty: 1 },
      { length: `12'-0"`, qty: 6 },
      { length: `12'-4"`, qty: 2 },
      { length: `15'-0"`, qty: 4 },
      { length: `15'-8"`, qty: 2 },
      { length: `19'-0"`, qty: 2 },
      { length: `20'-0"`, qty: 12 },
    ],
  },
  {
    mark: 'CORNER', size: '#4', shape: 'corner-bend',
    note: 'Bent at the corner',
    bars: [{ length: `4'-0"`, qty: 28 }],
  },
  {
    mark: 'LINTEL', size: '#5', shape: 'straight',
    note: 'Over openings',
    bars: [
      { length: `8'-4"`, qty: 4 },
      { length: `12'-4"`, qty: 2 },
    ],
  },
  {
    mark: 'RAKE', size: '#4', shape: 'peak-bend',
    note: 'Bent at the peak',
    bars: [{ length: `4'-0"`, qty: 2 }],
  },
  {
    mark: 'RAKE', size: '#4', shape: 'straight',
    note: 'Up the slope',
    bars: [{ length: `16'-7"`, qty: 4 }],
  },
  {
    mark: 'LIFT 1 VERTS', size: '#5', shape: 'straight',
    note: 'First grout lift',
    bars: [
      { length: `2'-4"`, qty: 1 },
      { length: `3'-0"`, qty: 3 },
      { length: `6'-6"`, qty: 85 },
    ],
  },
  {
    mark: 'LIFT 2 VERTS', size: '#5', shape: 'straight',
    note: 'Second grout lift',
    bars: [
      { length: `4'-0"`, qty: 1 },
      { length: `4'-3"`, qty: 1 },
      { length: `5'-2"`, qty: 1 },
      { length: `5'-10"`, qty: 47 },
      { length: `5'-11"`, qty: 6 },
      { length: `6'-1"`, qty: 8 },
      { length: `6'-6"`, qty: 16 },
      { length: `6'-11"`, qty: 2 },
      { length: `7'-1"`, qty: 4 },
      { length: `7'-8"`, qty: 2 },
    ],
  },
  {
    mark: 'RAKE VERTS', size: '#5', shape: 'straight',
    note: 'Verticals in the gable',
    bars: [
      { length: `4'-0"`, qty: 1 },
      { length: `4'-3"`, qty: 1 },
      { length: `4'-10"`, qty: 2 },
      { length: `5'-0"`, qty: 2 },
      { length: `5'-2"`, qty: 1 },
      { length: `5'-4"`, qty: 7 },
      { length: `5'-7"`, qty: 2 },
    ],
  },
];

// Printed on the sheet — used verbatim for the table's totals row.
const barTotals = { bars: 285, linearFeet: '2,031.4' };
const barLineItems = barGroups.reduce((sum, g) => sum + g.bars.length, 0);

const faqItems = [
  {
    question: 'What are masonry shop drawings?',
    answer: 'A masonry shop drawing is the submittal a masonry contractor provides showing exactly how the wall gets built: course-by-course elevations, dimensions, opening locations, special shapes (corners, bond beam, lintel units), reinforcing placement, and control joints. It translates the architect\'s design intent into the unit-by-unit layout the crew lays and the supplier orders from.',
  },
  {
    question: 'What does a CMU shop drawing have to show?',
    answer: 'Sizes and profiles of units, full coursing shown as wall elevations, locations of special shapes, every opening with its dimensions, reinforcing and rebar coordinated with bond beams and lintels, and control joint locations. The Masonry Modeler renders all of it from the coursing — courses numbered, lifts marked, openings labeled, bond beam courses and control joints in their real positions.',
  },
  {
    question: 'How long do masonry shop drawings take to produce?',
    answer: 'Drawn by hand or sent to a detailing service, a set runs days — and a full redraw every time the plans change. Because TMM tags every unit as you build the wall, the coursed, labeled elevation comes out automatically the moment the geometry exists. The shop drawing isn\'t a separate job; it\'s a byproduct of building the wall.',
  },
  {
    question: 'How much drafting do I have to do?',
    answer: 'None. You don\'t lay out sheets, place views, or set up callouts. You trace the wall and the sheets come out — plan, elevations, rebar layout, bar list. Change a wall height and they redraw themselves.',
  },
  {
    question: 'Can the drawings show architectural finishes like split face or ground face?',
    answer: 'Yes. Every segment is taggable by finish — stretcher, single score, split face, ground face — so banded courses and accent bands show on the elevation in their actual positions, color-coded, and carry straight through to the count and the order. Tag the wall once and the finish lives on the drawing and in the takeoff.',
  },
  {
    question: 'Does the set include a rebar bar list?',
    answer: 'Yes. The same model that lays out the coursing produces a steel bar list — every bar counted by mark and cut length, with a rebar and dowel layout sheet. Straight vertical and horizontal reinforcing, dowels, bond beam steel, lintel and rake bars are in scope. Pilaster hoops and bent bar are excluded — coordinate those with the rebar detailer.',
  },
  {
    question: 'Can I set where the grout lifts fall?',
    answer: 'Yes. Grout lifts are adjustable — set the lift heights to match the pour you\'re actually planning, and the lift lines move with them on the elevation. The drawing reflects how the wall gets built and grouted, not a fixed assumption, so the crew can plan their pours off the shop drawing itself.',
  },
  {
    question: 'Do the shop drawings update when the design changes?',
    answer: 'Yes. Change a wall height, swap a finish, move or resize an opening, and the elevation, coursing, labels, and counts redraw automatically. There is no re-detailing from scratch — the drawing is always a current reflection of the wall.',
  },
  {
    question: 'Is it worth making shop drawings for a small job?',
    answer: 'The submittal schedule won\'t ask for one on a trash enclosure. I draw it anyway. Field verify your dimensions, shop the cuts from your own yard, and the crew shows up to install — not to solve the wall standing on a scaffold. Once the wall\'s traced, the drawing costs nothing. The only question left is whether you\'d rather cut it in the yard or up on the scaffold.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer },
  })),
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Produce Masonry Shop Drawings Automatically",
  "description": "Generate a submittal-ready masonry shop drawing — coursed elevations with openings, special shapes, finishes, bond beams, and control joints, plus a steel bar list — directly from the wall instead of hand-detailing it.",
  "totalTime": "PT10M",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Trace the wall geometry",
      "text": "Draw the building perimeter, heights, and rakes to scale. The coursing is generated from the geometry, so the elevation reflects the wall as it will actually be laid." },
    { "@type": "HowToStep", "position": 2, "name": "Place the openings",
      "text": "Drop in doors and windows at their dimensions. Each opening is labeled on the elevation with its size and course location, with the jamb units and lintel course resolved around it." },
    { "@type": "HowToStep", "position": 3, "name": "Tag the units and finishes",
      "text": "Tag segments by finish and type — stretcher, single score, split face, ground face, bond beam, special shapes. The tags color-code the elevation and flow into the count and order." },
    { "@type": "HowToStep", "position": 4, "name": "Export the submittal-ready set",
      "text": "The set comes out with courses numbered, lifts marked, openings labeled, bond beam courses and control joints in position, plus a rebar layout and a steel bar list — the coursed layout a shop-drawing submittal requires." },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://themasonrymodeler.com/" },
    { "@type": "ListItem", "position": 2, "name": "Masonry Shop Drawings", "item": canonical },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <MasonXMonogram />
  <TitleBlock sheet="A2.4 — Masonry Shop Drawings" />

  <PageHero
    kicker="Shop Drawings · Coursed & Tagged"
    headline="Masonry Shop Drawings, Drawn As You Build"
    lead="A masonry shop drawing is a submittal requirement — coursing, openings, special shapes, reinforcing, finishes, laid out unit by unit. Done by hand it's days of masonry detailing and a redraw every time the plans move. TMM is masonry estimating software that tags every block as you build the wall, then renders the coursed, labeled elevation — and the steel bar list — automatically."
  />

  <section class="page-section">
    <div class="page-section-inner">
      <h2>Masonry Shop Drawings Are the Bottleneck Nobody Owns</h2>
      <p>
        Every masonry submittal needs a shop drawing — the coursed elevation that proves the wall before a block gets laid. And on most jobs it's the slowest, most expensive piece of paper in the package.
      </p>
      <p>
        You hand the architect's plans to a detailer or a service, wait days, and pay by the sheet. The person drawing your wall has probably never laid one. Then the plans change — a height, an opening, a finish band — and you're back in the queue waiting for a redraw. The drawing is always behind the job.
      </p>

      <div class="comparison-block">
        <div class="comparison-col">
          <span class="comparison-label">Hand-detailed / service</span>
          <h3>What you get</h3>
          <ul>
            <li>Days of turnaround, priced by the sheet</li>
            <li>Drawn by someone who doesn't lay block</li>
            <li>Coursing modeled from a drawing, not the wall</li>
            <li>Full redraw every time the plans move</li>
            <li>Drawing and takeoff live in separate files</li>
          </ul>
        </div>
        <div class="comparison-col">
          <span class="comparison-label">TMM, drawn as you build</span>
          <h3>What you get</h3>
          <ul>
            <li>Coursed elevation the moment the wall exists</li>
            <li>Built by the mason who knows the wall</li>
            <li>Coursing rendered from real block, corners and all</li>
            <li>Change the wall — the drawing redraws itself</li>
            <li>One model: drawing, count, order, and bar list in sync</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section page-section-dark">
    <div class="page-section-inner">
      <h2>Every Block Tagged, the Drawing Falls Out</h2>
      <p>
        TMM doesn't draw a picture of a wall. It renders the wall course by course — and because every segment is taggable, the drawing labels itself. This is Elevation D from the 15th pod set: a 28-foot gable end, rake coursing stepping up both slopes, a door with its lintel, split face carrying up into ground face, and a control joint run clean through the peak.
      </p>

      <figure class="drawing-figure drawing-figure-hero">
        <Image
          src={heroSheet.img}
          alt={heroSheet.alt}
          widths={[800, 1200, 1640]}
          sizes="(max-width: 900px) 92vw, 820px"
          loading="lazy"
        />
        <figcaption>
          <span>Elevation D · gable · rake coursing · split face → ground face · CJ through the peak</span>
          <span><strong>Powder River Masonry</strong> · MasonX · Sheet A05</span>
        </figcaption>
      </figure>

      <p>
        Courses are numbered up the elevation. Grout lifts are marked where you set them — adjust the lift heights and the lines move with the pour you're actually planning. Openings carry their size and location. Bond beam courses sit where the rebar schedule puts them. Control joints land in position. Finishes — stretcher, single score, split face, ground face — are tagged onto the segments, color-coded across the elevation in their real coursing positions. And the cut list comes out with it, so every cut piece is counted, not buried. All of it carried straight into the count and the order.
      </p>

      <div class="stat-block">
        <div class="stat-item">
          <span class="stat-value">Coursed</span>
          <span class="stat-label">Numbered course-by-course elevation</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">Tagged</span>
          <span class="stat-label">Finishes &amp; special shapes on every segment</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">Live</span>
          <span class="stat-label">Redraws when the wall changes</span>
        </div>
        <span class="stat-note">Elevations rendered in TMM · openings, bond beams, control joints, finishes labeled automatically</span>
      </div>

      <p>
        The proof that the units are typed, not drawn, is the legend. On Elevation A, every block is color-coded — <strong>corner, half, cut, bond beam</strong> — because the model knows what each unit is before it hits the elevation. That's not markup added over a picture; it's the wall reporting itself.
      </p>

      <figure class="drawing-figure">
        <Image
          src={legendSheet.img}
          alt={legendSheet.alt}
          widths={[800, 1200, 1640]}
          sizes="(max-width: 900px) 92vw, 820px"
          loading="lazy"
        />
        <figcaption>
          <span>Elevation A · legend keys every unit — corner / half / cut / bond beam</span>
          <span><strong>Powder River Masonry</strong> · MasonX · Sheet A02</span>
        </figcaption>
      </figure>

      <p>
        That's the whole point of tagging once: the shop drawing, the <a href="/masonry-takeoff-accuracy">block count</a>, and the supplier order are the same wall, not three documents you reconcile by hand. Change the finish band from split face to single score and it moves on the drawing and in the order at the same time.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="page-section-inner sheet-index-wide">
      <h2>Nine Sheets, One Trace</h2>
      <p>
        This is the full 15th pod set as it comes out of the model — plan, six elevations, a rebar and dowel layout, and a steel bar list. One trace of the wall produced every sheet. No re-entry, no second file to reconcile.
      </p>

      <div class="sheet-strip">
        {sheets.map((sheet, i) => (
          <a
            class="sheet-thumb"
            href={fullSheets[i].src}
            target="_blank"
            rel="noopener"
            aria-label={`Open sheet ${sheet.num} — ${sheet.short} — full size`}
          >
            <span class="sheet-thumb-frame">
              <Image
                src={sheet.img}
                alt={sheet.alt}
                widths={[320, 640]}
                sizes="(max-width: 700px) 44vw, 220px"
                loading="lazy"
              />
            </span>
            <span class="sheet-thumb-meta">
              <span class="sheet-thumb-num">{sheet.num}</span>
              <span class="sheet-thumb-title">{sheet.short}</span>
            </span>
          </a>
        ))}
      </div>
      <p class="sheet-strip-caption">Nine sheets, one trace, no re-entry.</p>
    </div>
  </section>

  <section class="page-section page-section-dark">
    <div class="page-section-inner">
      <h2>The Steel Comes Out With It</h2>
      <p>
        The same model that lays out the coursing counts the steel. The 15th pod set carries a steel bar list — <strong>285 bars, 2,031.4 linear feet</strong> — broken out by mark: bond beam, corner, lintel, rake, lift 1 verts, lift 2 verts, and rake verts. Shape codes ride along too — corner-bend and peak-bend — and every discrete cut length is counted separately.
      </p>
      <p>
        That's not linear feet with a waste factor thrown on top. It's a bar list you can hand to the supplier and order from.
      </p>

      <div class="stat-block">
        <div class="stat-item">
          <span class="stat-value">285</span>
          <span class="stat-label">Bars, counted by mark &amp; cut length</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">2,031.4</span>
          <span class="stat-label">Linear feet — discrete, not a waste factor</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">7</span>
          <span class="stat-label">Marks · corner-bend &amp; peak-bend shape codes</span>
        </div>
        <span class="stat-note">Steel bar list rendered from the same model as the coursing · Sheet A09</span>
      </div>

      <figure class="drawing-figure">
        <Image
          src={barListSheet.img}
          alt={barListSheet.alt}
          widths={[800, 1200, 1640]}
          sizes="(max-width: 900px) 92vw, 820px"
          loading="lazy"
        />
        <figcaption>
          <span>Steel bar list · 285 bars · 2,031.4 LF · by mark, size, shape, cut length, qty</span>
          <span><strong>Powder River Masonry</strong> · MasonX · Sheet A09</span>
        </figcaption>
      </figure>

      <p class="bar-list-note">
        These are the actual quantities off Sheet A09 — the full bar list, copied straight from the sheet, not a summary of it.
      </p>

      <details class="bar-list-details">
        <summary>Full bar list — {barLineItems} line items, {barTotals.bars} bars, {barTotals.linearFeet} LF</summary>
        <div class="bar-list-scroll">
          <table class="bar-list-table">
            <caption>Steel bar list, Sheet A09, 15th pod — mark, size, shape, cut length, and quantity for every bar in the set.</caption>
            <thead>
              <tr>
                <th scope="col">Mark</th>
                <th scope="col">Size</th>
                <th scope="col">Shape</th>
                <th scope="col">Length</th>
                <th scope="col">Qty</th>
              </tr>
            </thead>
            {barGroups.map((group) => (
              <tbody>
                {group.bars.map((bar) => (
                  <tr>
                    <th scope="row">
                      <span class="bar-mark">{group.mark}</span>
                      <span class="bar-note">{group.note}</span>
                    </th>
                    <td>{group.size}</td>
                    <td>{group.shape}</td>
                    <td class="num">{bar.length}</td>
                    <td class="num">{bar.qty}</td>
                  </tr>
                ))}
              </tbody>
            ))}
            <tfoot>
              <tr>
                <td colspan="3">Total</td>
                <td class="num">{barTotals.linearFeet} LF</td>
                <td class="num">{barTotals.bars}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </details>

      <figure class="drawing-figure">
        <Image
          src={rebarSheet.img}
          alt={rebarSheet.alt}
          widths={[800, 1200, 1640]}
          sizes="(max-width: 900px) 92vw, 820px"
          loading="lazy"
        />
        <figcaption>
          <span>Rebar &amp; dowel layout · #5 @ 48" O.C. vert · dowels and bond beam steel located</span>
          <span><strong>Powder River Masonry</strong> · MasonX · Sheet A08</span>
        </figcaption>
      </figure>

      <p>
        Here's the gap the industry lives with: masonry detailing services that model the coursing generally leave rebar quantities out of scope, and rebar detailers produce a bar schedule but not the coursing. You end up buying two sets of drawings that don't talk to each other. Here the same model produces both — the coursed elevations and the bar list, off one trace.
      </p>

      <p class="scope-note">
        <strong>Scope:</strong> straight vertical and horizontal reinforcing, dowels, bond beam steel, lintel and rake bars. Pilaster hoops and bent bar are excluded — coordinate those with the rebar detailer.
      </p>

      <div class="sample-download on-dark">
        <div class="sample-download-copy">
          <span class="sample-download-kicker">Sample set · 15th pod</span>
          <p>See the whole thing — all nine sheets, plan through bar list.</p>
        </div>
        <form class="sample-form" action="https://formspree.io/f/mykvgeld" method="POST">
          <input type="hidden" name="source" value="sample-download" />
          <input
            type="email"
            name="email"
            class="hero-form-input"
            placeholder="your@email.com"
            required
            autocomplete="email"
            aria-label="Email for the sample set download"
          />
          <button type="submit" class="hero-cta">
            Download the full sample set (9 sheets)
            <span class="hero-cta-arrow">↓</span>
          </button>
        </form>
