---
import Layout from '../../components/Layout.astro';
import MasonXMonogram from '../../components/MasonXMonogram.astro';
import TitleBlock from '../../components/TitleBlock.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://themasonrymodeler.com/" },
    { "@type": "ListItem", "position": 2, "name": "Field Notes", "item": "https://themasonrymodeler.com/blog/" },
  ],
};

const posts = [
  {
    num: '07',
    title: "Drawing Masonry in SketchUp — When the Model Doesn't Know It's a Wall",
    excerpt: "SketchUp draws boxes — it doesn't know coursing, bond, or special units. Here's why building masonry shop drawings in SketchUp by hand is so much work, and what should replace it.",
    date: 'June 2026',
    href: '/blog/masonry-shop-drawings-in-sketchup/',
  },
  {
    num: '06',
    title: "What Goes On a Masonry Shop Drawing (and Who Has to Draw It)",
    excerpt: "It's not the architect's drawing — it's yours, and you can't lay a block until it's approved. Here's what a CMU shop drawing has to show: coursing, special shapes, reinforcing, control joints.",
    date: 'June 2026',
    href: '/blog/whats-on-a-masonry-shop-drawing/',
  },
  {
    num: '05',
    title: "We All Label Shop Drawings in Bluebeam by Hand. Why?",
    excerpt: "The masonry shop drawing workflow everyone uses: export the rendering, drop it in Bluebeam, label every opening and course by hand. The drawing should label itself.",
    date: 'June 2026',
    href: '/blog/bluebeam-shop-drawings/',
  },
  {
    num: '04',
    title: "Half the Block, Two-Thirds the Price",
    excerpt: "A half block costs about two-thirds of a full one — your most expensive block per inch of wall. Miss the count and your bid is short, in the one direction you can't claw back.",
    date: 'June 2026',
    href: '/blog/half-block-cost/',
  },
  {
    num: '03',
    title: "The Corner Test: One Minute to Know If a Tool Actually Models Masonry",
    excerpt: "Every estimating demo looks good out in the flat. The corner is the one place area math can't fake. Here's a one-minute test you can run on anything you're using now.",
    date: 'June 2026',
    href: '/blog/the-corner-test/',
  },
  {
    num: '02',
    title: "The Software Sees the Corner. Why Am I Placing It?",
    excerpt: "Corner blocks carry a premium, and the software already rendered them on screen. So why does the takeoff still miss them — and why am I building corner units by hand for every banded color?",
    date: 'May 2026',
    href: '/blog/software-sees-the-corner/',
  },
  {
    num: '01',
    title: "It's 2026. Why Doesn't Masonry Software Know What a Corner Is?",
    excerpt: "I've been doing masonry takeoffs for years. I use spreadsheets and count everything by hand — because the tools that exist don't model masonry. They model rectangles.",
    date: 'May 2026',
    href: '/blog/why-i-built-this/',
  },
];
---

<Layout
  title="Blog | The Masonry Modeler"
  description="Field notes from building masonry estimating software. Written by a mason who got tired of doing exact piece counts by hand."
  canonical="https://themasonrymodeler.com/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <MasonXMonogram />
  <TitleBlock sheet="B0 — Blog" ctaLabel="Join Waitlist →" ctaHref="/#waitlist" />

  <div class="section-divider">
    <span>Field Notes</span>
    <span class="scale-marks"></span>
    <span>themasonrymodeler.com/blog</span>
  </div>

  <section class="blog-index-section">
    <div class="blog-index-inner">
      <h1>Field Notes</h1>
      {posts.map(post => (
        <a href={post.href} class="blog-post-card">
          <span class="card-num">{post.num}</span>
          <div class="card-content">
            <div class="card-title">{post.title}</div>
            <p class="card-excerpt">{post.excerpt}</p>
            <div class="card-date">{post.date} · 5 min read</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
