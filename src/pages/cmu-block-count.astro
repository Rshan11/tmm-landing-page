---
import Layout from '../components/Layout.astro';
import MasonXMonogram from '../components/MasonXMonogram.astro';
import TitleBlock from '../components/TitleBlock.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import FAQSection from '../components/FAQSection.astro';
import EstimateExample from '../components/EstimateExample.astro';

const title = 'CMU Estimating: Block Count to Bid | The Masonry Modeler';
const description = 'Learn how to estimate a CMU wall: block count, mortar, grout, labor, equipment, overhead, and profit. Follow a worked masonry estimate with sample rates.';
const canonical = 'https://themasonrymodeler.com/cmu-block-count/';

const faqItems = [
  {
    question: 'How do I turn a CMU block count into an estimate?',
    answer: 'Price the fulls, halves, and specialty units, then add mortar, grout, reinforcing, and accessories. Apply your production rates, crew labor, and equipment costs. Review allowances, tax, overhead, and profit against the project scope before issuing the bid.',
  },
  {
    question: 'Why is a block-by-block count more accurate than square footage?',
    answer: 'Square-footage takeoffs apply a factor — typically 1.125 blocks per square foot — then round up. That factor doesn\'t know about corners, openings, bond beams, or non-modular heights. Block-by-block counts each unit type individually, so the order matches what the crew actually lays.',
  },
  {
    question: 'What does "non-modular" mean and why does it matter?',
    answer: 'Non-modular means a dimension does not land on the selected unit module. A remaining height may need a specified half-high unit or a cut from full-height stock. Review both the placed piece and the unit you need to purchase.',
  },
  {
    question: 'How long does it take to trace a building and get a block count?',
    answer: 'The 88th Avenue pump station — 280 linear feet of perimeter, 12 wall segments — took 3.7 minutes from blank canvas to a full block-by-block takeoff. Larger projects take proportionally longer, but the tracing step is fast because it counts as you draw.',
  },
  {
    question: 'What block types does TMM count separately?',
    answer: 'Standard stretchers, corner blocks (inside and outside), bond beam units, lintel units, half-high blocks, sill blocks, and cut pieces at non-modular wall ends. Review the placed piece types and their purchased units separately from any waste allowance.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer },
  })),
};

const howToSchema = {
  "@context": "https://schema.org", "@type": "HowTo",
  "name": "How to prepare a masonry estimate",
  "description": "Review CMU quantities, apply your prices and production rates, then add overhead and profit for the defined scope.",
  "step": [
    { "@type": "HowToStep", "name": "Define the scope", "text": "Read plans and specifications; set wall geometry, openings, finishes, and reinforcement." },
    { "@type": "HowToStep", "name": "Review the takeoff", "text": "Check units, mortar, grout, reinforcing, accessories, and allowances." },
    { "@type": "HowToStep", "name": "Apply your costs", "text": "Use supplier quotes and loaded labor and equipment rates; check delivery, waste, and tax." },
    { "@type": "HowToStep", "name": "Price how you will build", "text": "Set production rates and crews; review laying, grouting, and other work." },
    { "@type": "HowToStep", "name": "Review the bid", "text": "Add overhead and profit, resolve missing scope or rates, and review against the plans." }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://themasonrymodeler.com/" },
    { "@type": "ListItem", "position": 2, "name": "CMU Block Count", "item": canonical },
  ],
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Building the 88th Avenue Pump Station in The Masonry Modeler",
  "description": "Three-minute trace of the 88th Avenue pump station in TMM — block-by-block, with stretchers, corners, bond beam units, and the half-high parapet course counted as separate line items.",
  "thumbnailUrl": ["https://i.ytimg.com/vi/m-fSK2uB924/maxresdefault.jpg"],
  "uploadDate": "2026-05-25",
  "duration": "PT3M",
  "embedUrl": "https://www.youtube.com/embed/m-fSK2uB924",
  "contentUrl": "https://youtu.be/m-fSK2uB924",
  "publisher": {
    "@type": "Organization",
    "name": "The Masonry Modeler",
    "url": "https://themasonrymodeler.com/",
  },
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  </Fragment>

  <MasonXMonogram />
  <TitleBlock sheet="A2.1 — CMU Block Count" />

  <PageHero
    kicker="CMU Estimating · Block by Block"
    headline="CMU estimating: from block count to bid"
    lead="Fulls, halves, and corners are counted from the first click as you draw your walls. The Masonry Modeler is masonry estimating software that connects the CMU wall you draw to the materials, crews, equipment, and markup in your bid."
  />

  <section class="page-section">
    <div class="page-section-inner">
      <h2>Start with the wall and specifications</h2>
      <p>
        Wall area is a useful starting check. For nominal 8-by-16-inch CMU, 1.125 units per square foot gives a full-unit equivalent. A purchase list also needs the actual fulls, halves, corners, bond beams, and cuts, plus the specified finishes and allowances.
      </p>
      <p>
        A corner's position and its purchased unit are related, but the specified block determines what you buy. Smooth 8-inch CMU may use regular stock at a corner; textured units or other widths can need special units. <a href="/blog/the-corner-test/">Review the corners</a>, openings, control joints, and non-modular heights before pricing.
      </p>

      <div class="comparison-block">
        <div class="comparison-col">
          <span class="comparison-label">Square-footage method</span>
          <h3>What you get</h3>
          <ul>
            <li>One number: total blocks</li>
            <li>Corners buried in waste factor</li>
            <li>Bond beams estimated, not scheduled</li>
            <li>Half-highs invisible until the job</li>
            <li>Cuts absorbed into rounding</li>
          </ul>
        </div>
        <div class="comparison-col">
          <span class="comparison-label">TMM block-by-block</span>
          <h3>What you get</h3>
          <ul>
            <li>Stretchers, corners, bond beam units — each separately</li>
            <li>Inside and outside corners counted by position</li>
            <li><a href="/bond-beam-estimating/">Bond beams from the rebar schedule, not a guess</a></li>
            <li>Half-high course as its own line item</li>
            <li>Cuts flagged and counted</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section page-section-dark">
    <div class="page-section-inner">
      <h2>The 88th Avenue Pump Station</h2>
      <p>
        Real job. Real numbers. The 88th Avenue pump station has a 280 linear foot perimeter broken into 12 wall segments. Rakes, a door, bond beam courses, non-modular height at the parapet.
      </p>
      <p>
        Tracing it in TMM took 3.7 minutes. The block count came out automatically — not a square-footage estimate adjusted upward, but a rendered wall with every unit in its position.
      </p>

      <div class="stat-block">
        <div class="stat-item">
          <span class="stat-value">280 lf</span>
          <span class="stat-label">Wall perimeter</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">12</span>
          <span class="stat-label">Wall segments</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">3.7 min</span>
          <span class="stat-label">Blank canvas → takeoff</span>
        </div>
        <span class="stat-note">88th Ave pump station · traced in TMM · all numbers confirmed</span>
      </div>

      <div class="video-frame on-dark">
        <iframe
          src="https://www.youtube-nocookie.com/embed/m-fSK2uB924"
          title="Building the 88th Avenue pump station in The Masonry Modeler"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
        <div class="video-frame-caption">
          <span>Pump Station · trace → takeoff · 3 min</span>
          <span><strong>Powder River Masonry</strong> · MasonX</span>
        </div>
      </div>

      <p>
        The takeoff separated stretchers, corner blocks, bond beam units, and the half-high parapet course. <a href="/masonry-takeoff-accuracy/">Not estimated. Counted.</a>
      </p>
      <p>
        And the same model labels the wall: that block count travels straight onto the <a href="/masonry-shop-drawings/">masonry shop drawings</a>, course by course.
      </p>
    </div>
  </section>

  <section class="page-section" id="estimate-workflow">
    <div class="page-section-inner">
      <h2>How to prepare a masonry estimate</h2>
      <ol class="estimate-steps">
        <li><strong>Define the scope.</strong> Read the plans and specifications. Set wall lengths, heights, thicknesses, finishes, openings, and reinforcement.</li>
        <li><strong>Review the takeoff.</strong> Check the fulls, halves, specialty units, cuts, mortar, grout, and reinforcing. Account for accessories and job-specific allowances.</li>
        <li><strong>Apply your costs.</strong> Use supplier quotes, mortar coverage, grout pricing, loaded labor costs, and equipment rates. Check delivery, minimum orders, waste, and tax.</li>
        <li><strong>Price how you will build.</strong> Set production rates and the working crew. Review the days for laying and grouting, plus access and other work.</li>
        <li><strong>Review the bid.</strong> Add overhead and profit, resolve missing scope or rates, and compare the estimate to the plans before sending it.</li>
      </ol>
      <p>The <a href="/#estimate-example">masonry estimating software overview</a> shows how the count connects to the bid. Below is one small worked example with all its assumptions visible.</p>
    </div>
  </section>

  <EstimateExample />

  <FAQSection
    items={faqItems}
    sectionNum="FAQ"
    label="Block count questions"
    headline="What the foreman always asks."
  />

  <PageCTA
    headline="Count every block before the order goes in."
    body="Trace the wall, get the count. Founder pricing at $300/mo while seats last."
  />
</Layout>

<style>
  .estimate-steps { padding-left: 1.4em; font-size: 18px; line-height: 1.75; }
  .estimate-steps li { margin: 0 0 18px; }
  #estimate-workflow { scroll-margin-top: 90px; }
</style>
