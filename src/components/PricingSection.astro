---
// Founder pricing — two cards. Card A (founder seat) is the highlighted/
// primary card; Card B is the plain "what a seat covers" card.
//
// Pricing copy updated 2026-08-01 to Ryan's wording. Deliberately NOT a live
// remaining-seat counter: the offer reads "first 10 companies", which carries
// the scarcity without asserting a number nobody is maintaining. When seats
// actually sell, a real counter can replace `seatCap` and it will be true.
interface Props {
  sectionNum?: string;
  label?: string;
  seatCap?: number;
  ctaHref?: string;
  ctaLabel?: string;
  contactEmail?: string;
}

const {
  sectionNum = '09',
  label = 'Pricing',
  seatCap = 10,
  ctaHref = '/#waitlist',
  ctaLabel = 'Join the waitlist',
  // Direct route for a buyer who is already convinced and doesn't want a
  // waitlist. TMM's own address — the product stands on its own brand.
  contactEmail = 'ryan@themasonrymodeler.com',
} = Astro.props;

const contactHref = `mailto:${contactEmail}?subject=${encodeURIComponent(
  'Founder seat — ready to talk'
)}&body=${encodeURIComponent(
  "Tell me about your outfit and the work you bid, and I'll get you set up."
)}`;

const founderFeatures = [
  'Block today — brick, stone and thin brick included as they ship, no upcharge',
  'Takeoff, bid & add-alternates with visible math',
  'Shop drawings, keyed elevations & placing sets',
  'Your crews, rates & regions on every project',
  'Direct line to the founder — your walls shape the roadmap',
];

const coverageFeatures = [
  'Unlimited projects & walls',
  'Every update, included — the roadmap ships weekly',
  "Your feedback becomes features: founders' walls get built first",
  'No per-report fees, no export fees, no surprise tiers',
];
---

<section class="pricing-section" id="pricing">
  <div class="pricing-inner">
    <div class="section-num" data-num={sectionNum}>{label}</div>
    <h2>Founder pricing. Locked for life.</h2>
    <p class="pricing-lead">
      Your rate is locked for life. Every wall type is included as it comes online —
      block today, brick, stone, and thin brick as they ship. No upcharge.
    </p>

    <div class="pricing-cards">
      <div class="pricing-card pricing-card-hot">
        <div class="pricing-card-head">Founder seat &mdash; first {seatCap} companies</div>
        <div class="pricing-amount">$300<span> per seat, per month</span></div>
        <ul class="pricing-list">
          {founderFeatures.map((item) => <li>{item}</li>)}
        </ul>
        <p class="pricing-note">
          Price never rises while your seat is active. <strong>You're buying it from the contractor who bids with it.</strong>
        </p>
        <a href={ctaHref} class="hero-cta pricing-cta">{ctaLabel}<span class="hero-cta-arrow">→</span></a>
        <p class="pricing-direct">
          Already sold? <a href={contactHref}>Talk to Ryan</a> — skip the list.
        </p>
      </div>

      <div class="pricing-card">
        <div class="pricing-card-head">What a seat covers</div>
        <div class="pricing-amount">Everything<span> &mdash; one seat, whole model</span></div>
        <ul class="pricing-list">
          {coverageFeatures.map((item) => <li>{item}</li>)}
        </ul>
        <p class="pricing-note">
          Bid one mid-size CMU job with it and the seat has paid for the year.
        </p>
      </div>
    </div>
  </div>
</section>
