---
// The shop-drawing "paper moment" — the one bright, white sheet on an
// otherwise dark page. The sheet image itself is the real 15th pod
// Sheet A02 / Elevation A, full resolution, unretouched.
//
// Reuses: .page-section-dark / .page-section-inner / .section-num.
// The .sheet-frame is a new, chalk/paper-toned adaptation of the existing
// .drawing-figure pattern (dark card + terracotta hard shadow) — inverted
// here so the sheet itself reads as physical paper laid on a dark surface.
// New classes live in the scratch CSS file (02-showcase.css).
import { Image } from 'astro:assets';
import sheetImg from '../assets/sheets/sheet-02-elevation-a.png';

interface Props {
  sectionNum?: string;
}

const { sectionNum = '04' } = Astro.props;
---

<section class="page-section page-section-dark sheet-moment" id="sheets">
  <div class="page-section-inner section-wide">
    <div class="section-num" data-num={sectionNum}>Shop drawings</div>
    <h2>The only takeoff that hands your foreman drawings.</h2>
    <p class="section-lede">The model that priced the job prints the job: keyed elevations on
      coursing, dims that land on block, jamb callouts, U.N.O. tags, and a piece count for
      <em>that sheet</em> — so the wall gets laid from the same numbers it was bid from. No
      re-drawing in CAD. No second source of truth.</p>

    <figure class="sheet-frame">
      <div class="sheet-frame-head">
        <span>Shop drawing set — 15th pod · 8" wall</span>
        <span>Sheet 02 · Elevation A · 1/2" = 1'-0"</span>
      </div>
      <Image
        src={sheetImg}
        alt="Actual TMM shop drawing, Sheet A02 Elevation A of the 15th pod — courses numbered C1
          through C15, every unit color-coded corner, half, cut, or bond beam per the legend,
          number 5 vertical rebar at 48 inches on center and number 4 bond-beam rebar overlaid,
          with dimensions and title block"
        widths={[800, 1200, 1640]}
        sizes="(max-width: 900px) 92vw, 1100px"
        loading="lazy"
      />
      <figcaption class="sheet-frame-cap">Actual sheet, unretouched — every course labeled, every
        corner / half / cut / bond beam color-coded, rebar overlaid. Generated by TMM from the
        same model that priced the wall.</figcaption>
    </figure>

    <p class="sheet-moment-closing">Generated, not drafted — change the wall and the sheet, the
      counts, and the bid all move together.</p>

    <a class="sheet-moment-link" href="/masonry-shop-drawings/">See the full nine-sheet set →</a>
  </div>
</section>
