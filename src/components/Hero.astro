---
import { Image } from 'astro:assets';
import heroImage from '../assets/pump-station-hero.png';

interface Props {
  waitlistHref?: string;
}
const { waitlistHref = '#waitlist' } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-tag">Now taking founder seats · 10 only</div>
      <h1>
        Square footage is a<br/>
        <span class="accent">lie</span> you tell your<br/>
        <span class="underline">supplier</span>.
      </h1>
      <p class="hero-kicker">Masonry estimating software built block-by-block.</p>
      <p class="hero-sub">
        Every estimating tool on the market counts area. Walls are made of blocks.
        TMM counts the blocks — corners, halves, cuts, bond beams, lintels, sills —
        <strong>as you draw the wall.</strong> You don't tell it where the halves go.
        It already knows.
      </p>
      <div id="waitlist" class="hero-waitlist-wrap">
        <form class="hero-form" id="waitlist-form" action="https://formspree.io/f/mykvgeld" method="POST">
          <input
            type="email"
            name="email"
            class="hero-form-input"
            placeholder="your@email.com"
            required
            autocomplete="email"
          />
          <button type="submit" class="hero-cta">
            Claim a founder seat
            <span class="hero-cta-arrow">→</span>
          </button>
        </form>
        <p class="hero-form-success" id="waitlist-success" style="display:none">
          You're in line. We'll be in touch.
        </p>
      </div>
      <div class="hero-pricing">
        Founder pricing locked at <strong>$300/mo for life</strong> · 10 seats only
      </div>
    </div>

    <div class="hero-render">
      <div class="render-titlebar">
        <span><span class="dot">◉</span> 88th Pump Station · Live Render</span>
        <span>TMM</span>
      </div>
      <div class="render-image">
        <Image
          src={heroImage}
          alt="TMM render of the 88th pump station — recessed single-score panels, bond beams, and interlocking corners, block by block"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="render-stats">
        <span>12 segments · 280 lf · recessed panels</span>
        <span><strong>under 4 min</strong> · blank canvas → takeoff</span>
      </div>
      <div class="render-mx-bubble">
        <span class="mx-mark inverted" aria-hidden="true">
          <svg><use href="#mx-monogram"/></svg>
        </span>
        <span class="render-mx-bubble-text">
          <strong>MasonX:</strong> Recessed panels, single score, splitface — and the
          bond runs straight through every face change. Count the increments yourself.
          I'll wait.
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const success = document.getElementById('waitlist-success') as HTMLElement;
  const emailInput = form?.querySelector('input[type="email"]') as HTMLInputElement;

  const focusEmail = () => {
    if (location.hash === '#waitlist' && emailInput && form?.style.display !== 'none') {
      emailInput.focus({ preventScroll: true });
    }
  };

  if (location.hash === '#waitlist') {
    window.addEventListener('load', () => setTimeout(focusEmail, 400));
  }
  window.addEventListener('hashchange', () => setTimeout(focusEmail, 400));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    } catch {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });
</script>
