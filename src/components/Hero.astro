---
import { Image } from 'astro:assets';
import planViewImage from '../assets/product/tmm-plan-view.jpg';

interface Props {
  waitlistHref?: string;
}
const { waitlistHref = '#waitlist' } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-tag">Masonry estimating &amp; shop drawings</div>
      <h1>
        It doesn't estimate the wall.<br/>
        <span class="accent">It builds it.</span>
      </h1>
      <p class="hero-sub">
        The Masonry Modeler is masonry estimating software that doesn't estimate at all.
        Trace your walls on the print. TMM lays the bond — <strong>every block, every cut,
        every bar</strong> — the way your crew will lay it. The count isn't a factor times
        square feet. It's the wall. <strong>Then it prints the shop drawings.</strong>
      </p>
      <div class="hero-actions">
        <div id="waitlist" class="hero-waitlist-wrap">
          <form class="hero-form" id="waitlist-form" action="https://formspree.io/f/mkodkqyy" method="POST">
            <input type="hidden" name="_subject" value="Waitlist signup" />
            <!-- Honeypot: bots fill this, humans never see it. Formspree discards
                 those submissions without counting them against the plan quota. -->
            <input type="text" name="_gotcha" class="fs-gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input
              type="email"
              name="email"
              class="hero-form-input"
              placeholder="your@email.com"
              required
              autocomplete="email"
            />
            <button type="submit" class="hero-cta">
              Join the waitlist
              <span class="hero-cta-arrow">→</span>
            </button>
          </form>
          <p class="hero-form-success" id="waitlist-success" style="display:none">
            You're on the list. We'll be in touch.
          </p>
        </div>
        <a class="hero-cta-secondary" href="#see-it">
          See a hard wall done right
          <span class="hero-cta-arrow">→</span>
        </a>
      </div>
      <div class="hero-pricing">
        Founder pricing: <strong>$300 per seat, per month</strong> · first 10 companies
      </div>
    </div>

    <div class="hero-render">
      <div class="render-titlebar">
        <span><span class="dot">◉</span> Plan View · Live Trace</span>
        <span>TMM</span>
      </div>
      <div class="render-image">
        <Image
          src={planViewImage}
          alt="The Masonry Modeler plan view: an architect's floor plan loaded as a print with walls traced over it in blue, 8-inch CMU wall type selected, and live segment stats"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="render-stats">
        <span>8" CMU · 10 lines · 14 segments</span>
        <span><strong>189'-4"</strong> traced</span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const success = document.getElementById('waitlist-success') as HTMLElement;
  const emailInput = form?.querySelector('input[type="email"]') as HTMLInputElement;

  const focusEmail = () => {
    if (location.hash === '#waitlist' && emailInput && form?.style.display !== 'none') {
      emailInput.focus({ preventScroll: true });
    }
  };

  if (location.hash === '#waitlist') {
    window.addEventListener('load', () => setTimeout(focusEmail, 400));
  }
  window.addEventListener('hashchange', () => setTimeout(focusEmail, 400));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    } catch {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });
</script>
