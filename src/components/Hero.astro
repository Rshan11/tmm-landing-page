---
import { Image } from 'astro:assets';
import heroImage from '../assets/pump-station-hero.png';

interface Props {
  waitlistHref?: string;
}
const { waitlistHref = '#waitlist' } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-tag">Now taking founder seats · 10 only</div>
      <h1>
        Counting the pieces<br/>
        takes <span class="accent">longer</span><br/>
        than the <span class="underline">takeoff</span>.
      </h1>
      <p class="hero-kicker">Masonry estimating software built block-by-block.</p>
      <p class="hero-sub">
        Trace the wall once. Bid from it, order from it, and draw the submittal from it.
        From the first wall you place, TMM knows where the corners are and what kind
        of block to lay. This masonry estimating software counts halves, cuts, bond beams,
        lintels, and sills <strong>as you draw.</strong> You shouldn't have to tell it.
      </p>
      <div id="waitlist" class="hero-waitlist-wrap">
        <form class="hero-form" id="waitlist-form" action="https://formspree.io/f/mykvgeld" method="POST">
          <input
            type="email"
            name="email"
            class="hero-form-input"
            placeholder="your@email.com"
            required
            autocomplete="email"
          />
          <button type="submit" class="hero-cta">
            Join the waitlist
            <span class="hero-cta-arrow">→</span>
          </button>
        </form>
        <p class="hero-form-success" id="waitlist-success" style="display:none">
          You're on the list. We'll be in touch.
        </p>
      </div>
      <div class="hero-pricing">
        Founder pricing locked at <strong>$300/mo for life</strong> · 10 seats only
      </div>
    </div>

    <div class="hero-render">
      <div class="render-titlebar">
        <span><span class="dot">◉</span> Pump Station · Live Render</span>
        <span>MasonryX</span>
      </div>
      <div class="render-image">
        <Image
          src={heroImage}
          alt="MasonryX render of a pump station building showing rakes, bond beam course, and red corner blocks interlocking through running bond"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="render-stats">
        <span>3 wall types · 14 rakes · 1 door</span>
        <span><strong>8 min</strong> · blank canvas → takeoff</span>
      </div>
      <div class="render-mx-bubble">
        <span class="mx-mark inverted" aria-hidden="true">
          <svg><use href="#mx-monogram"/></svg>
        </span>
        <span class="render-mx-bubble-text">
          <strong>MasonX:</strong> Look at the lintel. Bond steps clean across the
          opening. That's how the wall actually gets built.
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const success = document.getElementById('waitlist-success') as HTMLElement;
  const emailInput = form?.querySelector('input[type="email"]') as HTMLInputElement;

  const focusEmail = () => {
    if (location.hash === '#waitlist' && emailInput && form?.style.display !== 'none') {
      emailInput.focus({ preventScroll: true });
    }
  };

  if (location.hash === '#waitlist') {
    window.addEventListener('load', () => setTimeout(focusEmail, 400));
  }
  window.addEventListener('hashchange', () => setTimeout(focusEmail, 400));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    } catch {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  });
</script>
