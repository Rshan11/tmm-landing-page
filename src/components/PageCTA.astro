---
interface Props {
  headline?: string;
  body?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  headline = 'See it working on a real job.',
  body = 'See how your wall quantities become material costs, crew days, and a masonry bid. Request a walkthrough with Ryan.',
  ctaText = 'Book a demo',
  ctaHref = '/#demo',
} = Astro.props;
---

<section class="page-cta-section">
  <h2>{headline}</h2>
  <p>{body}</p>
  <a href={ctaHref} class="hero-cta">{ctaText}<span class="hero-cta-arrow">→</span></a>
</section>
