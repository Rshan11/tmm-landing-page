---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'The Masonry Modeler — masonry estimating software built block-by-block',
  description = 'Masonry estimating software that renders every block — corners, lintels, bond beams. Built by a mason. Founder seats open at $300/mo.',
  canonical = 'https://themasonrymodeler.com/',
} = Astro.props;

const siteUrl = 'https://themasonrymodeler.com';
const ogImage = `${siteUrl}/assets/og-image.png`;
const ogImageAlt = 'The Masonry Modeler — pump station render showing block-by-block masonry estimating';

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Ryan Shanley, Powder River Masonry" />
  <meta name="theme-color" content="#b8451a" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />

  <!-- Google Fonts — font-display: swap applied via display=swap param -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&display=swap"
    rel="stylesheet"
  />

  <!-- JSON-LD Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "The Masonry Modeler",
    "alternateName": "TMM",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "Construction Estimating Software",
    "operatingSystem": "Web",
    "description": "Masonry estimating software that renders every block — corners, lintels, bond beams, halves, cuts — as you draw. Built by a mason.",
    "url": "https://themasonrymodeler.com/",
    "offers": {
      "@type": "Offer",
      "price": "300",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "300",
        "priceCurrency": "USD",
        "billingDuration": "P1M",
        "unitText": "MONTH"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "Powder River Masonry"
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Powder River Masonry",
    "url": "https://themasonrymodeler.com/",
    "founder": {
      "@type": "Person",
      "name": "Ryan Shanley"
    }
  }
  </script>

  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
