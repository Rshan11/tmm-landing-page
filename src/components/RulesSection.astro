---
import RuleCard from './RuleCard.astro';

const rules = [
  {
    num: 'R-01',
    stamp: '01 · CORNERS',
    title: 'My corners interlock. Bond runs through.',
    body: 'No butt joints unless you tell me otherwise. Inside, outside — the corner is just what happens when the bond is right. Not a special case bolted on top.',
  },
  {
    num: 'R-02',
    stamp: '02 · LEFTOVER',
    title: 'I absorb the leftover into the corner.',
    body: 'The leg moves 8" every course — same as the bond. You won\'t catch a 4" cut sitting out in the field on my walls.',
  },
  {
    num: 'R-03',
    stamp: '03 · CTRL JOINTS',
    title: 'I default control joints to 24\'‑8". Not 25\'.',
    body: '296" = 18.5 blocks × 16" exactly. That\'s the modular number. Drag me to override. I\'ll never auto-place one within 16" of a corner.',
  },
  {
    num: 'R-04',
    stamp: '04 · BOND BEAMS',
    title: 'Rebar drives my bond beams. Not a checkbox.',
    body: 'Set the schedule from the structural drawings. Courses snap. I extend dev-length past openings. Weight reported in pounds, not just LF.',
  },
  {
    num: 'R-05',
    stamp: '05 · HALF-HIGH',
    title: 'I catch half-highs without being asked.',
    body: 'Wall\'s not modular 8"? I generate the half-high at top or bottom and break it out as its own line item. Counted, weighted, priced — not buried in waste factor.',
  },
  {
    num: 'R-06',
    stamp: '06 · NO SLIVERS',
    title: 'I won\'t produce a cut under 4". Ever.',
    body: 'If the layout would force it, I absorb into adjacent joints or shift the cut to the next valid position. By design. You won\'t talk me into a sliver.',
  },
  {
    num: 'R-07',
    stamp: '07 · CMU CORNERS',
    title: '10" and 12" corners get 8" + face shell.',
    body: 'Separate line items, the way the supplier ships them and the way your crew lays them. I\'m not going to lie to your takeoff.',
  },
  {
    num: 'R-08',
    stamp: '08 · OVERRIDE',
    title: 'I\'m right 90% of the time. You\'re the mason.',
    body: 'Click any block, change the type, the takeoff updates. I won\'t argue. You\'ve been on the wall longer than I have.',
  },
];
---

<section class="rules">
  <div class="rules-inner">
    <div class="rules-header">
      <div class="section-num" data-num="04">What the model knows</div>
      <h2>What a mason <span class="accent">already</span> knew.</h2>
      <div class="mx-signature" style="margin-top: 24px;">
        <span class="mx-mark" aria-hidden="true">
          <svg><use href="#mx-monogram"/></svg>
        </span>
        <span>The rules <strong>MasonX</strong> lays by — every wall, every time.</span>
      </div>
    </div>

    <div class="rules-grid" role="list" aria-label="MasonX rules">
      {rules.map((rule) => (
        <div role="listitem">
          <RuleCard {...rule} />
        </div>
      ))}
    </div>
  </div>
</section>
