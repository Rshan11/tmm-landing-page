---
import RuleCard from './RuleCard.astro';

const rules = [
  {
    num: 'R-01',
    stamp: '01 · CORNERS',
    title: 'My corners interlock. Inside and out.',
    body: 'Bond runs through the corner — it doesn\'t stop there and apologize. No butt joints unless you tell me otherwise. The corner isn\'t a feature bolted on top of the wall. It\'s what happens when the bond is right.',
  },
  {
    num: 'R-02',
    stamp: '02 · LEFTOVER',
    title: 'I absorb the leftover into the corner.',
    body: 'Wall\'s not modular? The leg takes it, and it moves with the bond every course. You will not find a 4" cut sitting out in the field on one of my walls. That sliver is a confession, and I don\'t confess.',
  },
  {
    num: 'R-03',
    stamp: '03 · CTRL JOINTS',
    title: 'I default CJs to 24\'-8". Not 25\'.',
    body: '296" = 18.5 blocks × 16", exactly. That\'s the modular number — 25 feet is what people write when they\'ve never had to lay to it. Drag me to override. I will never auto-place a joint within 16" of a corner.',
  },
  {
    num: 'R-04',
    stamp: '04 · BOND BEAMS',
    title: 'Rebar drives my bond beams. Not a checkbox.',
    body: 'Set the schedule from the structural drawings and the courses snap to it. Dev-length extension past openings is automatic. Steel reported in pounds — because that\'s how your supplier prices it, and LF-only takeoffs are how you get surprised.',
  },
  {
    num: 'R-05',
    stamp: '05 · HALF-HIGH',
    title: 'I catch half-highs without being asked.',
    body: 'Wall isn\'t modular 8"? The half-high course generates at top or bottom and breaks out as its own line item. Counted, weighted, priced. Not buried in a waste factor like a mistake you\'re hoping nobody audits.',
  },
  {
    num: 'R-06',
    stamp: '06 · NO SLIVERS',
    title: 'A cut under 4" doesn\'t exist. Not on my walls.',
    body: 'If the layout would force one, I absorb into the joints or shift the cut to the next valid position. By design. You can\'t talk me into a sliver, and neither can the architect.',
  },
  {
    num: 'R-07',
    stamp: '07 · CMU CORNERS',
    title: '10" and 12" corners get 8" block + face shell.',
    body: 'Separate line items — the way the supplier ships them and the way your crew lays them. I\'m not going to flatten that into one number and lie to your takeoff.',
  },
  {
    num: 'R-08',
    stamp: '08 · OVERRIDE',
    title: 'I\'m right 90% of the time. You\'re the mason.',
    body: 'Click any block, change the type, the takeoff updates. I won\'t argue. You\'ve been on the wall longer than I have, and the software that forgets that deserves to get uninstalled.',
  },
];
---

<section class="rules">
  <div class="rules-inner">
    <div class="rules-header">
      <div class="section-num" data-num="04">What the engine knows</div>
      <h2>What a mason <span class="accent">already</span> knew.</h2>
      <div class="mx-signature" style="margin-top: 24px;">
        <span class="mx-mark" aria-hidden="true">
          <svg><use href="#mx-monogram"/></svg>
        </span>
        <span>The rules <strong>MasonX</strong> lays by — every wall, every time. Not settings. Not options. Rules.</span>
      </div>
    </div>

    <div class="rules-grid" role="list" aria-label="MasonX rules">
      {rules.map((rule) => (
        <div role="listitem">
          <RuleCard {...rule} />
        </div>
      ))}
    </div>
  </div>
</section>
