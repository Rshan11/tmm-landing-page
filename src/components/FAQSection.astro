---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  sectionNum?: string;
  label?: string;
  headline?: string;
}

const {
  items,
  sectionNum = '05',
  label = 'Common questions',
  headline = 'Questions the job site asks.',
} = Astro.props;
---

<section class="faq-section">
  <div class="faq-inner">
    <div class="section-num" data-num={sectionNum}>{label}</div>
    <h2>{headline}</h2>
    {items.map((item) => (
      <div class="faq-item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </div>
</section>
