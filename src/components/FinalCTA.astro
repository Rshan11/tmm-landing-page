---
import SiteFooter from './SiteFooter.astro';
// Homepage closer — reuses the .page-cta-section pattern (ink bg, centered,
// big Oswald headline) established by PageCTA.astro, plus a simple site
// footer bundled in the same component (see build report for why).
interface Props {
  headline?: string;
  body?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  headline = "Bid the masonry takeoff the way you'll build it.",
  body = "Walk through the takeoff, estimate, and shop drawings with Ryan. Bring questions about the work you bid.",
  ctaHref = '/#demo',
  ctaLabel = 'Book a demo',
} = Astro.props;

---

<section class="page-cta-section">
  <h2>{headline}</h2>
  <p>{body}</p>
  <a href={ctaHref} class="hero-cta">{ctaLabel}<span class="hero-cta-arrow">→</span></a>
</section>

<SiteFooter />
