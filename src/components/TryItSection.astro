---
// "Try a real job" — the Georgeville pump station field view, embedded and interactive.
// The iframe loads only when scrolled near (desktop) or on tap (phones), so the
// 3-D model never costs first paint. Marks made in the demo stay on the visitor's device.
interface Props { sectionNum?: string; headline?: string; lede?: string; }
const {
  sectionNum = '01',
  headline = 'Try a real job.',
  lede = "This is a pump station from one of our own jobs, running live in your browser. Turn it, tap a wall, pick a lift, tap a bar, then switch on Production and mark work done. Nothing you do here is saved to anyone's job.",
} = Astro.props;
---

<section class="page-section tryit-section" id="try-it">
  <div class="page-section-inner section-wide">
    <div class="section-num" data-num={sectionNum}>Try it</div>
    <h2>{headline}</h2>
    <p class="section-lede">{lede}</p>

    <div class="tryit-frame" id="tryitFrame" data-src="/demo/pump-station/">
      <button type="button" class="tryit-load" id="tryitLoad">
        <span class="tryit-load-btn">Load the 3-D model</span>
        <span class="tryit-load-sub">Georgeville pump station &middot; tap to start</span>
      </button>
    </div>
    <p class="tryit-fallback"><a href="/demo/pump-station/">Open full screen</a> for the best view on a phone.</p>
  </div>
</section>

<style>
  .tryit-frame {
    position: relative;
    margin-top: 28px;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(128, 128, 128, 0.35);
    background: #1b1f22 url('/assets/video/pump-station-demo-poster.jpg') center / cover no-repeat;
  }
  .tryit-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }
  .tryit-load {
    position: absolute; inset: 0; width: 100%; border: 0; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    background: rgba(10, 14, 16, 0.45); color: #fff; font: inherit;
  }
  .tryit-load-btn { background: #fff; color: #111; padding: 12px 22px; border-radius: 8px; font-weight: 600; font-size: 16px; }
  .tryit-load-sub { font-size: 13px; opacity: 0.9; }
  .tryit-fallback { margin-top: 10px; font-size: 14px; }
  @media (max-width: 700px) {
    .tryit-frame { aspect-ratio: auto; height: 78vh; min-height: 520px; max-height: 760px; }
  }
</style>

<script>
  const box = document.getElementById('tryitFrame');
  const btn = document.getElementById('tryitLoad');
  let loaded = false;
  function load() {
    if (loaded || !box) return;
    loaded = true;
    const f = document.createElement('iframe');
    f.src = box.dataset.src!;
    f.title = 'Interactive 3-D model of the Georgeville pump station in The Masonry Modeler';
    f.loading = 'lazy';
    f.setAttribute('allowfullscreen', '');
    box.appendChild(f);
    btn?.remove();
  }
  btn?.addEventListener('click', load);
  // Desktop / tablets: load when it scrolls near. Phones: wait for the tap (keeps data + page scroll smooth).
  const phone = window.matchMedia('(max-width: 700px)').matches;
  if (!phone && box && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { load(); io.disconnect(); } }, { rootMargin: '200px' });
    io.observe(box);
  } else if (!phone) load();
</script>
