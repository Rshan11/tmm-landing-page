<!-- MasonX SVG symbol defs. Include once per page, then reference via
     <use href="#mx-monogram"/> inside any .mx-mark element. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="mx-monogram" viewBox="0 0 40 34">
      <!-- Hardhat dome -->
      <path class="mx-hat" d="M 4 24 Q 4 8, 20 6 Q 36 8, 36 24 L 32 24 Q 32 14, 20 12 Q 8 14, 8 24 Z"/>
      <!-- Crown ridge -->
      <rect class="mx-hat" x="19" y="6" width="2" height="4" rx="1"/>
      <!-- Brim -->
      <path class="mx-brim" d="M 2 24 L 38 24 L 38 28 Q 38 30, 36 30 L 4 30 Q 2 30, 2 28 Z"/>
      <!-- MX letters -->
      <text class="mx-letters" x="20" y="22" text-anchor="middle">MX</text>
    </symbol>
  </defs>
</svg>
