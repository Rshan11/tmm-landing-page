// Tells Cloudflare Workers Builds where the built static site lives.
// Without this, branch/preview builds run `wrangler versions upload` with no
// target and fail with "Missing entry-point to Worker script or to assets directory".
// Values mirror the live tmm-landing-page Worker so production deploys don't change.
{
  "name": "tmm-landing-page",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  // Workers Builds has no build command set, so wrangler builds the site itself.
  "build": {
    "command": "npm run build"
  },
  // worker/index.js serves /api/progress/<job> (field view production marks, D1) and hands every
  // other request to the static assets unchanged.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // HTML page paths run the Worker first so the private visit counter (worker/stats.js) sees
    // them; every other file (blocks/rebar/meta/usdz, _astro, images) is served by assets directly.
    "run_worker_first": ["/", "/*/", "/*.html"]
  },
  "d1_databases": [
    { "binding": "PROGRESS", "database_name": "tmm-progress", "database_id": "949cd138-7ec7-4075-96b7-9fedd4bd2989", "migrations_dir": "migrations" }
  ]
}
